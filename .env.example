# Environment
ENV=development
DEBUG=True

# Local API & WebSocket Configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=marketeval

# Async SQLAlchemy / AsyncPG Connection String
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/marketeval

# NLP Engine Configurations
MODEL_NAME=VinAI/phobert-base
VECTOR_DIMENSION=768

# Telegram Notification Bot (Optional for Phase 5)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here